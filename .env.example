# Скопируй в .env:  cp .env.example .env
# .env лежит в .gitignore и на GitHub не уедет. Репозиторий публичный:
# утёкший ключ отзывается за минуты. В код и промпты ключ не вставлять.

# Токен бота от @BotFather. Никогда не коммитьте заполненный .env.
TELEGRAM_BOT_TOKEN=

# Локальный PostgreSQL из docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://standbot:standbot@localhost:5432/standbot
