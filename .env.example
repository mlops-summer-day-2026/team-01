# Скопируйте файл в .env. Заполненный .env нельзя коммитить.
TELEGRAM_BOT_TOKEN=123456789:AA_ТВОЙ_ТОКЕН

# Необязательно: порт PostgreSQL на хосте. Внутри Compose используется 5432.
POSTGRES_HOST_PORT=55432

# Необязательно: локальный порт скрытой WOW-страницы.
WOW_HOST_PORT=8088

# Публичная ссылка для скрытой Telegram-команды /bali.
WOW_PUBLIC_URL=https://mlops-summer-day-2026.github.io/team-01/boss-mode/
